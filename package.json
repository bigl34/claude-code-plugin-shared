{
  "name": "@local/cli-utils",
  "version": "1.0.0",
  "description": "Shared CLI utilities with Zod validation for plugin CLIs",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "test": "npx --yes tsx --test tests/*.test.ts",
    "prepare": "npm run build"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "typescript": "5.9.3"
  }
}
